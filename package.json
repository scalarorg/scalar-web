{
  "name": "scalar-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "i": "bun install --no-optional",
    "type-check": "tsc -b",
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "lint": "biome check --unsafe --no-errors-on-unmatched --files-ignore-unknown=true ./",
    "format": "biome check --write --unsafe --no-errors-on-unmatched --files-ignore-unknown=true ./",
    "preview": "vite preview",
    "postinstall": "bunx simple-git-hooks",
    "generate-api": "rimraf ./src/types/schema.ts && openapi-typescript ./src/assets/openapi.yaml -o ./src/types/schema.ts",
    "sync-api": "bash scripts/sync.sh",
    "gen-api": "bun run sync-api && bun run generate-api"
  },
  "simple-git-hooks": {
    "pre-commit": "bunx lint-staged"
  },
  "lint-staged": {
    "**/*.{js,ts,tsx,json,css,md}": ["biome format --write", "biome check"]
  },
  "dependencies": {
    "@bitcoin-js/tiny-secp256k1-asmjs": "^2.2.3",
    "@cosmjs/proto-signing": "^0.33.0",
    "@cosmjs/stargate": "^0.33.0",
    "@cosmjs/tendermint-rpc": "^0.33.0",
    "@hookform/resolvers": "^4.1.3",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toast": "^1.2.14",
    "@rainbow-me/rainbowkit": "^2.2.8",
    "@scalar-lab/bitcoin-vault": "^0.0.35",
    "@scalar-lab/scalarjs-sdk": "0.0.3",
    "@tailwindcss/vite": "^4.1.11",
    "@tanstack/react-query": "^5.83.0",
    "@tanstack/react-router": "1.105.0",
    "@tanstack/react-table": "^8.21.3",
    "bitcoinjs-lib": "^7.0.0-rc.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.0.0",
    "cosmjs-types": "^0.9.0",
    "dayjs": "^1.11.13",
    "ethers": "^6.15.0",
    "inflection": "^3.0.2",
    "lodash": "^4.17.21",
    "long": "^5.3.1",
    "lucide-react": "^0.477.0",
    "next-themes": "^0.4.6",
    "numeral": "^2.0.6",
    "openapi-fetch": "^0.13.8",
    "openapi-react-query": "^0.3.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-dropzone": "^14.3.8",
    "react-hook-form": "^7.60.0",
    "react-icons": "^5.5.0",
    "react-image-crop": "^11.0.10",
    "recharts": "^2.15.4",
    "sonner": "^2.0.6",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.11",
    "tailwindcss-animate": "^1.0.7",
    "usehooks-ts": "^3.1.1",
    "viem": "^2.33.0",
    "wagmi": "^2.16.0",
